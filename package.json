{
  "name": "dex-swap-gateway",
  "version": "0.1.0",
  "description": "DEX Swap proxy gateway for ZeroWallet - proxies OKX DEX API with HMAC signing",
  "main": "src/index.ts",
  "scripts": {
    "start": "cp -n .env.example .env 2>/dev/null; wrangler dev",
    "dev": "wrangler dev",
    "deploy": "dotenv -- wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "generate-sdk": "bash scripts/generate-flutter-sdk.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@zero-wallet/chain-utils": "file:../../packages/chain-utils",
    "dotenv-cli": "^11.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0",
    "wrangler": "^3.0.0"
  },
  "dependencies": {
    "hono": "^4.12.16",
    "js-sha3": "^0.9.3"
  }
}
