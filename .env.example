# DEX Swap Gateway 环境变量配置

# OKX API 凭证（https://web3.okx.com/zh-hans/onchainos/dev-portal/project 开发者后台创建）
OKX_API_KEY=your-okx-api-key
OKX_SECRET_KEY=your-okx-secret-key
OKX_API_PASSPHRASE=your-passphrase
OKX_PROJECT_ID=your-project-id

# OKX API 地址（默认不变）
OKX_BASE_URL=https://www.okx.com

# Cloudflare 部署（https://dash.cloudflare.com/profile/api-tokens 创建 Workers 权限的 token）
CLOUDFLARE_API_TOKEN=

# 代币列表缓存 TTL（秒）
TOKEN_CACHE_TTL=60

# Jupiter Swap API v2（Solana DEX 聚合器）
# 需要从 https://developers.jup.ag/portal 获取 API key
JUPITER_API_KEY=your-jupiter-api-key
# Jupiter API 地址（默认不变）
JUPITER_BASE_URL=https://api.jup.ag/swap/v2
